{{- with .CommonLabels.severity }} [{{ . }}]{{ end }}
{{- with .CommonLabels.service }} service={{ . }}{{ end }}
{{- with .CommonLabels.component }} component={{ . }}{{ end }}
{{- with .CommonLabels.slo }} slo={{ . }}{{ end }}
{{ range $i, $a := .Alerts }}{{ if lt $i 10 }}
• {{ if eq $a.Status "resolved" }}(resolved) {{ end }}{{ if $a.Annotations.summary }}{{ $a.Annotations.summary }}{{ else }}{{ $a.Labels.SortedPairs.Values | join " " }}{{ end }}
  since {{ $a.StartsAt.UTC.Format "01-02 15:04" }} UTC
{{- end }}{{ end }}
{{- if gt (len .Alerts) 10 }}
… and {{ len .Alerts | printf "%d" }} in total{{ end }}
{{ with .CommonAnnotations.description }}
{{ . }}
