    {
      "id": 10,
      "type": "timeseries",
      "title": "同一条边的四段耗时 p50",
      "description": "顶部变量选一条边。四条线从外到内：调用方进程认为的耗时、调用方边车、被调用方边车、被调用方进程自己处理的耗时（单位统一成秒）。相邻两条线的差就是中间那一段（边车、网络）花的时间。被调用方进程一线是该服务这个接口收到的全部调用，不区分调用方；一个服务有多个调用方时只作量级参考。外层线比内层线低说明时间范围或桶的粗细造成了误差，不是负耗时。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rpc_client_call_duration_seconds_bucket{k8s_namespace_name=\"$namespace\", service_name=\"$source\", rpc_method=~\"oppenheimer\\\\.$destination\\\\.v1\\\\..*\"}[$__rate_interval])))",
          "legendFormat": "调用方进程",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\", namespace=\"$namespace\", source_workload=\"$source\", destination_service_name=\"$destination\"}[$__rate_interval]))) / 1000",
          "legendFormat": "调用方边车（source）",
          "refId": "B",
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"destination\", namespace=\"$namespace\", source_workload=\"$source\", destination_service_name=\"$destination\"}[$__rate_interval]))) / 1000",
          "legendFormat": "被调用方边车（destination）",
          "refId": "C",
          "range": true,
          "editorMode": "code"
        },
        {
