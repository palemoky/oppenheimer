  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "调用边：请求量与错误（调用方边车视角）",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "请求量（每条边）",
      "description": "每条调用边（调用方 → 被调用方）经调用方边车的 QPS。回答：流量在哪几条边上、有没有某条边突然掉到 0 或暴涨。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source_workload, destination_service_name) (rate(istio_requests_total{reporter=\"source\", namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{source_workload}} → {{destination_service_name}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx 比例（每条边）",
      "description": "边车看到的 5xx（HTTP 状态码）占该边请求的比例。gRPC 业务错误在 HTTP 层是 200，所以这里的 5xx 基本都是边车自己造的：路由超时 504、并发上限或无健康上游 503。持续大于 0 就不正常。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source_workload, destination_service_name) (rate(istio_requests_total{reporter=\"source\", namespace=\"$namespace\", response_code=~\"5..\"}[$__rate_interval])) / sum by (source_workload, destination_service_name) (rate(istio_requests_total{reporter=\"source\", namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{source_workload}} → {{destination_service_name}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "gRPC 非 OK 状态码（每条边）",
      "description": "grpc_response_status 不是 0 的请求速率。常见：4 DEADLINE_EXCEEDED、8 RESOURCE_EXHAUSTED（限流或舱壁）、9 FAILED_PRECONDITION（降级）、14 UNAVAILABLE。4、14 持续出现不正常；8、9 是服务在保护自己，看比例。边车自己拒绝的请求没有 grpc 状态，标签是空。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source_workload, destination_service_name, grpc_response_status) (rate(istio_requests_total{reporter=\"source\", namespace=\"$namespace\", grpc_response_status!=\"0\"}[$__rate_interval]))",
          "legendFormat": "{{source_workload}} → {{destination_service_name}} 状态 {{grpc_response_status}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "response_flags 非空（每条边）",
      "description": "Envoy 的响应标志，“-”表示没有异常，这里只画有标志的。UO：上游溢出，并发上限（connectionPool）触发；UF：连不上上游；UH：没有健康的上游，全被摘除；UT：上游请求超时；URX：重试次数用完；UC：上游连接被中断；UR：上游重置；NR：没有路由；DC：下游（调用方）断开；LR：本地重置。UO、UH、UT 出现说明保护机制在起作用。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source_workload, destination_service_name, response_flags) (rate(istio_requests_total{reporter=\"source\", namespace=\"$namespace\", response_flags!=\"-\"}[$__rate_interval]))",
          "legendFormat": "{{source_workload}} → {{destination_service_name}} {{response_flags}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
