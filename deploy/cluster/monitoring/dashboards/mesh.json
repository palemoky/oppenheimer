    {
      "id": 7,
      "type": "timeseries",
      "title": "延迟 p50（source 与 destination 两个视角）",
      "description": "每条边的 p50 延迟，分别由调用方边车（source）和被调用方边车（destination）记录；两条线的差是网络加两个边车之间的开销。直方图的桶很粗（…、10、25、50、100、250 毫秒），分位数是桶内插值，只看量级和变化。source 线持续高于 destination 线很多说明边车或网络有排队。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, reporter, source_workload, destination_service_name) (rate(istio_request_duration_milliseconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{reporter}} {{source_workload}} → {{destination_service_name}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
