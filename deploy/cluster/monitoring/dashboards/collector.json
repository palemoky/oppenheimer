{
  "id": null,
  "uid": "opp-collector",
  "title": "Oppenheimer / Collector",
  "tags": [
    "oppenheimer"
  ],
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 41,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(otelcol_process_uptime, pod)",
        "query": {
          "query": "label_values(otelcol_process_uptime, pod)",
          "refId": "v"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "接收",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "接收速率",
      "description": "Collector 各接收器每秒接收的 span、指标点、日志条数（按 pod 和信号）。流量骤降说明上游没在发或采集停了。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(otelcol_receiver_accepted_spans{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} spans",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(otelcol_receiver_accepted_metric_points{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} 指标点",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(otelcol_receiver_accepted_log_records{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} 日志",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "拒收速率",
      "description": "接收器因下游反压（如 memory_limiter 触发）而拒绝的数据。应为 0；非 0 说明 Collector 过载，上游会重试或丢数据。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(otelcol_receiver_refused_spans{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} spans",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(otelcol_receiver_refused_metric_points{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} 指标点",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(otelcol_receiver_refused_log_records{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} 日志",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "接收失败速率",
      "description": "接收器解析或处理出错的数据，应为 0。与拒收不同：失败是数据本身或内部处理有问题。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(otelcol_receiver_failed_spans{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} spans",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(otelcol_receiver_failed_metric_points{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} 指标点",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(otelcol_receiver_failed_log_records{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} 日志",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
