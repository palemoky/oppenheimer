# 集群的地址和规格，scripts/cluster/ 下的脚本都读这一份。说明见 docs/infra/hardware.md 的“网络”。
# R2S 的 DHCP 池是 192.168.50.100 到 249，.1 到 .32 是给各设备的静态绑定；这里用的地址都在两者之外。
# R2S 的代理有按地址的白名单：.7 和 .40 到 .44 已放行，节点只能用这几个地址才出得了网。

# 宿主机（Ubuntu 3900X）
HOST_SSH="${HOST_SSH:-ubt}"          # MacBook 上 ~/.ssh/config 里的别名
HOST_NIC="enp41s0"                   # 接到网桥上的有线网卡：PCIe 的 RTL8126，插在 PCI_E4（名字跟着插槽变，挪插槽后要改这里；板载的 enp39s0 只能协商到百兆，已不用）
HOST_BRIDGE="br0"
HOST_IP="192.168.50.7"              # 网桥的静态地址；R2S 上按有线网卡的 MAC 绑定了同一个地址，并在代理白名单里

# 兜底的管理通道：板载网口。平时不插线；有线网卡或网桥出问题时把网线插到它上面就能从 HOST_FALLBACK_IP 登录。
# 它和网桥在同一个网段，靠按源地址的策略路由分开（host-setup.sh 里有说明）。
HOST_FALLBACK_NIC="enp39s0"
HOST_FALLBACK_IP="192.168.50.6"
HOST_FALLBACK_TABLE="106"            # 策略路由用的路由表编号，不和别的冲突就行

# Wi-Fi：平时的管理通道（ssh ubt）。地址是 R2S 按 MAC 绑定后由 DHCP 给的，连接的配置（接入点和密码）在
# 宿主机上安装器写的 /etc/netplan/00-installer-config-wifi.yaml 里，不在仓库。这里只用来加同样的策略路由，
# 让它在网桥没有上联时也能登录。接口名跟着插槽变，挪插槽后这里和安装器的那个文件都要改。
HOST_WIFI_NIC="wlp35s0"
HOST_WIFI_IP="192.168.50.8"
HOST_WIFI_TABLE="108"

LAN_NET="192.168.50.0"
LAN_PREFIX="24"
LAN_GATEWAY="192.168.50.2"           # R2S，同时是 DNS 和出网代理
LAN_DNS="192.168.50.2"

# 虚拟机（k3s 节点）。每项：名字:地址:vCPU:内存MiB:磁盘GB:网卡MAC
# 内存合计 42 GiB，宿主机 48 GiB（系统认到约 47 GiB），留约 5 GiB 给宿主机；KVM 不预先占满，虚拟机用多少才占多少。
# 三台各 14 GiB：监控放在 server 上（ADR-0030）。之前是 10、16、16，再之前是 6、11、11 GiB（宿主机 32 GiB）。改这里的内存之后运行 vm.sh resize <名字>。
# MAC 固定下来：重建虚拟机后地址不变，R2S 和邻居的 ARP 表不用等过期。52:54:00 是 QEMU/KVM 的前缀。
NODES=(
  "k3s-server:192.168.50.40:4:14336:60:52:54:00:00:50:40"
  "k3s-agent-1:192.168.50.41:8:14336:150:52:54:00:00:50:41"
  "k3s-agent-2:192.168.50.42:8:14336:150:52:54:00:00:50:42"
)
VM_USER="ubuntu"                       # cloud image 的默认用户，免密 sudo，只能用密钥登录
VM_IMAGE_DIR="/var/lib/libvirt/images" # 宿主机上 600G 的卷（ubuntu-vg/vmpool）
VM_BASE_IMAGE="$VM_IMAGE_DIR/base/ubuntu-26.04-server-cloudimg-amd64.img"
VM_NETWORK="host-bridge"

# k3s（设计文档 2a 第 3 节）。固定版本，不走通道：通道会前移，重建出来的集群版本就变了。
K3S_VERSION="v1.37.2+k3s1"
K3S_SERVER_NODE="k3s-server"           # NODES 里作为 server 的那一台，其余都是 agent
KUBECONFIG_OUT="${KUBECONFIG_OUT:-$HOME/.kube/oppenheimer.yaml}" # MacBook 上的 kubeconfig，在仓库之外
KUBE_CONTEXT="oppenheimer"

# MetalLB 的地址池（ADR-0025）。池里不自动分配，每个 Service 写明要哪个地址。
LB_POOL="192.168.50.50-192.168.50.59"
LB_REGISTRY_IP="192.168.50.50"         # 镜像仓库，端口 5000
LB_GATEWAY_IP="192.168.50.51"          # 对外入口（Envoy Gateway）
REGISTRY_ADDR="$LB_REGISTRY_IP:5000"

# 集群组件的版本（登记在 docs/infra/versions.md）
METALLB_VERSION="0.16.2"               # Helm chart 版本，和应用版本 v0.16.2 一致
REGISTRY_VERSION="3.1.2"               # distribution，Docker Hub 的 registry 镜像
ENVOY_GATEWAY_VERSION="v1.10.0"        # Helm chart 和应用同一个版本号；它的兼容性表：Kubernetes v1.34 到 v1.37
STRIMZI_VERSION="1.3.1"                # Kafka 的 Operator；它支持的 Kafka 版本到 4.3.2（deploy/cluster/kafka/kafka.yaml）
ISTIO_VERSION="1.32.0"               # 服务网格；chart 和 istioctl 来自 GitHub 的发布包；支持 Kubernetes 1.33 到 1.37
# 可观测（设计文档 3a、ADR-0030），装在命名空间 monitoring。
KPS_VERSION="93.3.1"                   # kube-prometheus-stack 的 Helm chart；带 operator v0.95.2、Grafana 13.3.1、Alertmanager v0.35.0
PROMETHEUS_VERSION="v3.13.5-distroless" # Prometheus 的镜像 tag：3.13 是 LTS（到 2027-07-31），chart 默认的是 3.16
GRAFANA_HOST="grafana.oppenheimer.test" # 经入口（LB_GATEWAY_IP）访问 Grafana 用的 Host
# Loki 和 Tempo 的 chart 在 grafana-community 的仓库。2026-11-17 查证：旧仓库 grafana.github.io/helm-charts 里的 tempo、
# tempo-distributed 已标 deprecated（停在 Tempo 2.9.0），loki 停在 7.6.0（Loki 3.6.18）；新仓库里的 loki、tempo 是继任者。
GRAFANA_COMMUNITY_REPO="https://grafana-community.github.io/helm-charts"
LOKI_CHART_VERSION="21.3.1"            # grafana-community/loki；chart 默认的应用版本就是 3.7.10，不用在 values 里覆盖
LOKI_VERSION="3.7.10"                  # GitHub releases 的最新正式版（4.0 只有 rc）；镜像 docker.io/grafana/loki:3.7.10 存在
TEMPO_CHART_VERSION="3.2.1"            # grafana-community/tempo（单体模式）；tempo-distributed 是微服务模式，不用
TEMPO_VERSION="3.1.1"                  # GitHub releases 的最新正式版，也是 chart 的默认应用版本；镜像 docker.io/grafana/tempo:3.1.1 存在
OTELCOL_CHART_VERSION="0.178.3"        # open-telemetry/opentelemetry-collector（仓库 https://open-telemetry.github.io/opentelemetry-helm-charts）；chart 默认的应用版本是 0.163.2，用下面的覆盖
OTELCOL_VERSION="0.165.0"              # GitHub releases 的最新正式版；镜像 docker.io/otel/opentelemetry-collector-contrib:0.165.0 存在（要 contrib：用到 transform、filelog、otlphttp）
# 中间件的 exporter（ADR-0030 第 8 项），装在命名空间 monitoring，多目标模式，一个 Deployment 抓全部实例；Kafka 用 Strimzi 自带的，没有版本要登记。
MYSQLD_EXPORTER_VERSION="v0.21.0"      # GitHub releases 的最新正式版（2026-10-22）；镜像 quay.io/prometheus/mysqld-exporter:v0.21.0 存在（tag 带 v，有 amd64、arm64）。MySQL 9.7.4 上实测可用（见 docs/infra/versions.md）
REDIS_EXPORTER_VERSION="v1.97.0"       # GitHub releases 的最新正式版（2026-11-04）；镜像 docker.io/oliver006/redis_exporter:v1.97.0-alpine 存在（tag 带 v，有 amd64、arm64）
# 按请求速率伸缩（设计文档 3a 的 3.8、ADR-0030 第 10 项），装在命名空间 keda。
KEDA_VERSION="2.21.1"                  # kedacore/keda 的 Helm chart，和应用版本一致；GitHub releases 的最新正式版（2026-11-15）。官方测试的 Kubernetes 是 1.34 到 1.36，我们是 1.37：实测可用（见 docs/infra/versions.md）

# NAS 的 NFS（设计文档 2a 第 6 节）。共享文件夹由主人在 DSM 里建，子目录由脚本经 NFS 创建。
NAS_IP="192.168.50.3"
NAS_EXPORT="/volume1/k8s"
